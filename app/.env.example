# Postgres (Neon, Supabase or local)
DATABASE_URL="postgresql://user:pass@localhost:5432/localhost_dev"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Email (Resend). Without a key, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="Localhost <tickets@localhost.events>"

# Stripe. Without keys, only free tiers work.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
